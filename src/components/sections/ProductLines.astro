---
/**
 * Linhas de produto — fase "oferta" da biblioteca B2.
 *
 * VARIANTE LOCAL desta LP, pedida pelo cliente em 21/10/2026 (mockup da seção de
 * serviços, docs/BRIEFING.md) e retrabalhada a pedido do usuário em 26/10/2026, como a
 * LP de compressores de parafuso: vira duas seções com o respiro padrão e fundo alternado.
 *   1. `#linhas` (branca) — logo depois do hero, a faixa do carrossel de marcas atendidas e,
 *      abaixo dela, a abertura em duas colunas: texto e duas fotos com a mesma altura.
 *   2. `#servicos` (cinza) — os cards de serviço, com caixa de imagem no lugar do ícone.
 * A faixa de CTA final saiu a pedido do usuário (26/10/2026). O contrato da seção é o
 * mesmo da biblioteca — dados, CTAs `linhas-{id}`, um card escuro, `tone`/`rhythm`; os
 * tons das duas seções são fixos aqui.
 *
 * ATENÇÃO: `npm run compose` recopia o componente da biblioteca e desfaz esta variante.
 * Recompor a página exige reaplicá-la a partir do git.
 */
import { Image } from 'astro:assets'
import Section from '@components/Section.astro'
import Icon from '@components/Icon.astro'
import BrandCarousel from '@components/BrandCarousel.astro'
import type { SectionProps } from '@lib/layout'
import { cta } from '@data/content'
import { productLines, type ProductLine } from '@data/sections/linhas'

type Props = SectionProps

const { rhythm } = Astro.props
const lines: readonly ProductLine[] = productLines.items
const [photo1, photo2] = productLines.gallery
---

{/* 1. Marcas e abertura numa seção só (pedido do usuário, 26/10/2026) */}
<Section id="linhas" tone="light" rhythm={rhythm}>
  {/* Faixa das marcas atendidas: rótulo e carrossel de logos da LP de peças */}
  <div class="flex flex-col gap-4 rounded-2xl border border-brand-blue/10 bg-neutral-gray-100 px-5 py-4 lg:flex-row lg:items-center lg:gap-10 lg:px-8">
    <span class="flex shrink-0 items-center gap-4 font-display text-[17px] font-extrabold text-primary-dark">
      <span aria-hidden="true" class="h-[3px] w-10 shrink-0 rounded-full bg-brand-yellow"></span>
      {productLines.brands.label}
    </span>
    <span aria-hidden="true" class="hidden h-10 w-px shrink-0 bg-primary-dark/15 lg:block"></span>
    <div class="linhas-brands min-w-0 flex-1">
      <BrandCarousel />
    </div>
  </div>

  {/* Abertura em duas colunas. No desktop as fotos têm a altura da coluna de texto
      (pedido do usuário, 26/10/2026): a imagem fica absoluta para não empurrar a linha. */}
  <div class="mt-14 grid gap-10 lg:mt-16 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] lg:items-stretch lg:gap-12">
    <div>
      <p class="flex items-center gap-4 font-sans text-[13px] font-bold tracking-[0.14em] text-brand-blue uppercase sm:text-[14px]">
        <span aria-hidden="true" class="h-[3px] w-10 shrink-0 rounded-full bg-brand-yellow"></span>
        {productLines.eyebrow}
      </p>
      <h2 class="mt-4 font-display title-section leading-[1.08] font-extrabold tracking-[-0.03em] text-primary-dark">
        {productLines.title}
      </h2>
      <p class="mt-5 max-w-xl font-sans text-lead text-ink-soft">{productLines.text}</p>

      {/* O que entra na manutenção, em cartões curtos */}
      <ul class="mt-8 grid gap-3 sm:grid-cols-3">
        {productLines.highlights.map((item) => (
          <li class="flex items-center gap-3 rounded-2xl border border-brand-blue/10 bg-neutral-light p-3.5 shadow-[0_10px_30px_-24px_rgba(0,33,71,0.35)]">
            <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-brand-yellow-soft text-[#00256f]">
              <Icon name={item.icon} class="size-5" />
            </span>
            <span class="font-display text-[15px] leading-tight font-bold text-primary-dark">
              {item.label}
            </span>
          </li>
        ))}
      </ul>
    </div>

    <div class="grid grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] gap-3 sm:gap-4">
      <figure class="relative h-56 overflow-hidden rounded-2xl bg-neutral-gray-100 sm:h-72 lg:h-auto">
        <Image
          src={photo1.src}
          alt={photo1.alt}
          width={450}
          format="webp"
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover lg:absolute lg:inset-0"
        />
        <span class="absolute bottom-3 left-3 flex items-center gap-2 rounded-full bg-neutral-light px-3 py-2 font-sans text-[12px] font-bold text-brand-blue shadow-[0_10px_24px_-14px_rgba(0,33,71,0.6)] sm:bottom-4 sm:left-4 sm:px-4 sm:py-2.5 sm:text-[14px]">
          <Icon name={productLines.badge.icon} class="size-4 shrink-0 sm:size-5" />
          {productLines.badge.label}
        </span>
      </figure>
      <figure class="relative h-56 overflow-hidden rounded-2xl bg-neutral-gray-100 sm:h-72 lg:h-auto">
        <Image
          src={photo2.src}
          alt={photo2.alt}
          width={680}
          format="webp"
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover lg:absolute lg:inset-0"
        />
      </figure>
    </div>
  </div>
</Section>

{/* 2. Cards de serviço, um escuro, com caixa de imagem no lugar do ícone (pedido do usuário,
    26/10/2026). Sem `cardPhoto`, a caixa mostra o espaço reservado da foto do serviço. */}
<Section id="servicos" tone="gray" rhythm={rhythm}>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 lg:gap-5">
    {lines.map((line, i) => (
      <article
        class:list={[
          'flex flex-col rounded-2xl border p-4 transition-[transform,box-shadow] duration-300 ease-out hover:-translate-y-1 motion-reduce:transition-none motion-reduce:hover:translate-y-0 xl:p-5',
          line.dark
            ? 'border-transparent bg-[linear-gradient(160deg,#0550ab_0%,#0043a1_55%,#003a8f_100%)] shadow-[0_24px_48px_-28px_rgba(0,55,127,0.8)]'
            : 'border-[#e3e8f1] bg-neutral-light shadow-[0_10px_30px_-24px_rgba(0,33,71,0.35)] hover:shadow-[0_24px_48px_-28px_rgba(0,33,71,0.4)]',
        ]}
      >
        <figure
          class:list={[
            'relative aspect-[16/10] overflow-hidden rounded-xl',
            line.dark ? 'bg-white/10' : 'bg-neutral-gray-100',
          ]}
        >
          {line.cardPhoto ? (
            <Image
              src={line.cardPhoto.src}
              alt={line.cardPhoto.alt}
              width={480}
              format="webp"
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover"
            />
          ) : (
            <span
              class:list={[
                'flex h-full w-full flex-col items-center justify-center gap-2 rounded-xl border-2 border-dashed',
                line.dark
                  ? 'border-white/25 text-neutral-light/60'
                  : 'border-[#d5dcea] text-[#9aa7bf]',
              ]}
            >
              <Icon name="camera" class="size-8" />
              <span class="font-sans text-[12px] font-semibold tracking-[0.12em] uppercase">
                Imagem · {line.tag}
              </span>
            </span>
          )}
          <span class="absolute top-3 left-3 flex size-9 items-center justify-center rounded-lg bg-brand-yellow font-display text-[15px] font-extrabold text-primary-dark-900">
            {String(i + 1).padStart(2, '0')}
          </span>
        </figure>

        <div class="flex flex-1 flex-col px-2 pt-5 pb-2">
          <h3
            class:list={[
              'font-display text-[21px] leading-[1.2] font-extrabold tracking-[-0.015em] lg:text-[19px] xl:text-[20px] xl:whitespace-nowrap 2xl:text-[22px]',
              line.dark ? 'text-neutral-light' : 'text-brand-blue',
            ]}
          >
            {line.title}
          </h3>
          <p
            class:list={[
              'mt-3 font-sans text-[15px] leading-relaxed xl:text-[16px]',
              line.dark ? 'text-neutral-light/85' : 'text-ink-soft',
            ]}
          >
            {line.description}
          </p>

          <div class="mt-auto pt-6">
            <button
              type="button"
              data-cta={`linhas-${line.id}`}
              class:list={[
                'btn-slave-whats inline-flex w-full items-center justify-between gap-4 border-b-2 pb-2 font-sans text-[15px] font-bold transition-colors duration-200 motion-reduce:transition-none',
                line.dark
                  ? 'border-white/45 text-neutral-light hover:border-brand-yellow'
                  : 'border-brand-blue/25 text-brand-blue hover:border-brand-blue',
              ]}
            >
              {cta.card}
              <Icon
                name="arrow-right"
                class:list={[
                  'size-5 shrink-0 [stroke-width:2.2]',
                  line.dark ? 'text-brand-yellow' : 'text-brand-blue',
                ]}
              />
            </button>
          </div>
        </div>
      </article>
    ))}
  </div>
</Section>

<style>
  /* Logos por vez: 2 no celular, 3 no tablet e 5 no desktop, para não ficarem minúsculas.
     O !important vence o --brand-visible que o carrossel grava no style do próprio elemento. */
  .linhas-brands :global(.brand-carousel) {
    --brand-visible: 2 !important;
  }

  @media (width >= 40rem) {
    .linhas-brands :global(.brand-carousel) {
      --brand-visible: 3 !important;
    }
  }

  @media (width >= 64rem) {
    .linhas-brands :global(.brand-carousel) {
      --brand-visible: 5 !important;
    }
  }
</style>
