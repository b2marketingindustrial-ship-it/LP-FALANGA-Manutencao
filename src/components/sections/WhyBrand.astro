---
/**
 * Diferenciais — fase "autoridade" da biblioteca B2.
 *
 * VARIANTE LOCAL desta LP, pedida pelo cliente em 21/10/2026 (mockup "Por que escolher a
 * Falanga", docs/BRIEFING.md): cabeçalho, os 5 motivos em cards de 3 colunas com ícone em
 * quadrado amarelo e numeração, e um card azul de CTA fechando a grade. O card azul é o
 * bloco escuro da segunda metade da página. O contrato da seção é o mesmo da biblioteca
 * — 5 motivos, CTA `diferenciais-cta`, `tone`/`rhythm` —, com a descrição até 110
 * caracteres (scripts/lib/contract.mjs).
 *
 * ATENÇÃO: `npm run compose` recopia o componente da biblioteca e desfaz esta variante.
 * Recompor a página exige reaplicá-la a partir do git.
 */
import Section from '@components/Section.astro'
import Icon from '@components/Icon.astro'
import type { SectionProps } from '@lib/layout'
import { cta } from '@data/content'
import { why } from '@data/sections/diferenciais'

type Props = SectionProps

const { tone, rhythm } = Astro.props
---

<Section id="diferenciais" tone={tone} rhythm={rhythm}>
  {/* Cabeçalho */}
  <p class="flex items-center gap-4 font-sans text-[13px] font-bold tracking-[0.24em] text-brand-blue uppercase sm:text-[14px]">
    <span aria-hidden="true" class="h-[3px] w-10 shrink-0 rounded-full bg-brand-yellow"></span>
    {why.eyebrow}
  </p>
  <h2 class="mt-4 font-display text-[2.1rem] leading-[1.08] font-extrabold tracking-[-0.03em] text-brand-blue sm:text-[2.6rem] lg:text-[3rem] xl:text-[3.25rem]">
    {why.titleLines.map((line) => (
      <span class="lg:block">{line} </span>
    ))}
  </h2>
  <p class="mt-4 max-w-4xl font-sans text-lg leading-relaxed text-ink-soft">{why.text}</p>

  {/* 5 motivos e o card de CTA */}
  <div class="mt-9 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-5">
    {why.reasons.map((reason, i) => (
      <article class="reason-card relative flex flex-col rounded-2xl bg-neutral-light p-7 shadow-[0_14px_36px_-26px_rgba(0,33,71,0.45)] xl:p-8">
        <div class="flex items-start justify-between">
          <span class="flex size-[68px] items-center justify-center rounded-xl bg-brand-yellow-soft text-brand-blue">
            <Icon name={reason.icon} class="size-11" />
          </span>
          <span class="font-display text-[17px] font-semibold text-[#bec3d1]">
            {String(i + 1).padStart(2, '0')}
          </span>
        </div>
        <h3 class="mt-5 font-display text-[22px] leading-tight font-extrabold tracking-[-0.015em] text-brand-blue xl:text-[24px]">
          {reason.title}
        </h3>
        <p class="mt-3 font-sans text-[15px] leading-relaxed text-ink-soft xl:text-[16px]">
          {reason.description}
        </p>
      </article>
    ))}

    <article class="why-cta relative flex flex-col justify-center overflow-hidden rounded-2xl p-7 shadow-[0_24px_48px_-28px_rgba(0,55,127,0.8)] xl:p-8">
      <span aria-hidden="true" class="h-[4px] w-14 rounded-full bg-brand-yellow"></span>
      <p class="relative mt-5 font-display text-[24px] leading-tight font-extrabold tracking-[-0.015em] text-neutral-light xl:text-[26px]">
        {why.closing.title}
      </p>
      <p class="relative mt-2 font-sans text-[15px] leading-relaxed text-neutral-light/85 xl:text-[16px]">
        {why.closing.text}
      </p>
      <button
        type="button"
        data-cta="diferenciais-cta"
        class="btn-slave-whats relative mt-6 inline-flex w-full items-center justify-between gap-3 rounded-xl bg-brand-yellow px-7 py-4 font-sans text-[17px] font-bold text-primary-dark-900 shadow-[0_14px_30px_-16px_rgba(0,0,0,0.5)] transition-colors duration-200 hover:bg-brand-yellow-dark motion-reduce:transition-none"
      >
        {cta.card}
        <Icon name="arrow-right" class="size-5 shrink-0 [stroke-width:2.4]" />
      </button>
    </article>
  </div>
</Section>

<style>
  /* Fio azul no topo de cada card, acompanhando o raio (como no mockup). */
  .reason-card {
    border-top: 3px solid var(--color-brand-blue);
  }

  /* Card de CTA: azul royal com faixas diagonais discretas. */
  .why-cta {
    background:
      linear-gradient(
        120deg,
        transparent 0 58%,
        rgb(255 255 255 / 0.06) 58% 70%,
        transparent 70% 78%,
        rgb(255 255 255 / 0.05) 78% 88%,
        transparent 88%
      ),
      linear-gradient(160deg, #0858b8 0%, var(--color-brand-blue) 55%, #003a8f 100%);
  }
</style>
