---
/**
 * ESTRUTURA FIXA (PROMPT-PADRAO-LP 4.1.2). Grid desktop: texto (1fr) · coluna VAZIA (270px) · shortcode (340px).
 * A coluna 2 é a janela do banner; nunca coloque conteúdo nela.
 * Abra a página com `?grid=1` para ver as colunas e o início da foto.
 *
 * Desvio pedido pelo cliente em 21/10/2026 (segundo mockup da abertura): o técnico e o
 * compressor começam logo depois do texto, com a foto ancorada ao fim da coluna 1 até a
 * borda da tela. Pílula com a frase de efeito e o H1 com a palavra-chave como título grande
 * (primeira linha em branco, a segunda em amarelo); os quatro pontos ficam numa barra
 * de vidro; um único CTA, em pílula amarela, com a área atendida embaixo.
 * Registrado em docs/BRIEFING.md.
 *
 * Regras das LPs de compressores de parafuso e de peças, levadas para esta (26/10/2026):
 * altura definida pelo conteúdo, com 100px acima dos textos e abaixo do botão; shortcode
 * do chat sozinho na coluna 3, de 340px, sem card; conteúdo até 1450px; CTA do sistema `cta`.
 */
import { Picture } from 'astro:assets'
import Icon from './Icon.astro'
import { hero, cta } from '../data/content'

const isDev = import.meta.env.DEV
---

{/* Desktop: altura definida pelo conteúdo, com 100px de respiro acima dos textos e abaixo do botão. */}
<section class="hero relative overflow-hidden [container-type:inline-size]" data-hero>
  {/* z1 — banner: faixa no rodapé da seção no mobile; no desktop, do fim da coluna de texto à borda da tela */}
  <div class="hero-photo hero-fade absolute inset-x-0 bottom-0 z-[1] h-[300px] lg:inset-y-0 lg:h-auto">
    <Picture
      src={hero.banner.src}
      alt={hero.banner.alt}
      widths={[640, 1024, 1536, 1981]}
      sizes="(min-width: 1024px) 1660px, 700px"
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="h-full w-full object-cover object-left lg:w-auto lg:max-w-none"
      pictureAttributes={{ class: 'block h-full w-full' }}
    />
  </div>

  {/* z5 — conteúdo */}
  <div class="page-container relative z-[5] pt-14 pb-[320px] lg:py-[100px]">
    <div class="hero-grid grid items-center gap-y-12 lg:gap-x-6">
      {/* Coluna 1 — textos */}
      <div class="max-w-xl lg:max-w-none">
        {/* H1 com a palavra-chave da campanha, na forma de linha de abertura */}
        {/* Pílula com a frase de efeito, como nas LPs de parafuso e peças */}
        <p class="inline-flex items-center gap-2 rounded-full border border-brand-yellow/40 bg-white/[0.06] px-3 py-1 font-sans text-[11px] font-bold tracking-[0.12em] text-brand-yellow uppercase sm:text-[12px]">
          <span aria-hidden="true" class="size-1.5 shrink-0 rounded-full bg-brand-yellow"></span>
          {hero.pill}
        </p>

        {/* H1 com o foco da página em duas linhas: a palavra-chave em branco e o fim da frase
            em amarelo (pedido do usuário, 26/10/2026) */}
        <h1 class="mt-5 font-display text-[2rem] leading-[1.06] font-extrabold tracking-[-0.03em] text-neutral-light sm:text-[2.6rem] lg:text-[2.1rem] xl:text-[2.6rem] 2xl:text-[2.9rem]">
          <span class="block lg:whitespace-nowrap">{hero.title}</span>
          <span class="block text-brand-yellow lg:whitespace-nowrap">{hero.tail}</span>
        </h1>

        <p class="mt-5 max-w-[32rem] font-sans text-lead text-neutral-light/90">{hero.text}</p>

        {/* 4 pontos numa linha só, ícone ao lado do texto, numa barra de vidro com separadores,
            como nas LPs de parafuso e peças (26/10/2026); texto sempre em duas linhas. Abaixo de
            640px voltam à grade 2×2, por falta de largura. */}
        <ul class="hero-glass mt-8 grid grid-cols-2 gap-x-4 gap-y-4 rounded-2xl p-4 sm:flex sm:w-max sm:items-center sm:gap-0 sm:px-1 sm:py-3">
          {hero.points.map((point) => (
            <li class="flex items-center gap-2.5 sm:border-l sm:border-white/15 sm:px-4 sm:first:border-l-0">
              <Icon name={point.icon} class="size-9 shrink-0 text-brand-yellow sm:size-8" />
              <span class="font-sans text-[14px] leading-tight font-semibold text-neutral-light sm:text-[13px]">
                <span class="block whitespace-nowrap">{point.line1}</span>
                <span class="block whitespace-nowrap">{point.line2}</span>
              </span>
            </li>
          ))}
        </ul>

        <button type="button" data-cta="hero-primary" class="btn-slave-whats cta cta-yellow mt-9">
          {cta.primary}
          <Icon name="arrow-right" class="shrink-0" />
        </button>

        {/* Área atendida, separada por ponto */}
        <p class="mt-5 flex flex-wrap items-center gap-x-2.5 gap-y-1 font-sans text-[15px] font-medium text-neutral-light/90">
          {hero.area.map((item, i) => (
            <>
              {i > 0 && (
                <span aria-hidden="true" class="text-neutral-light/60">
                  •
                </span>
              )}
              <span>{item}</span>
            </>
          ))}
        </p>
      </div>

      {/* Coluna 2 — VAZIA de propósito: janela do banner */}
      <div class="hidden lg:block" aria-hidden="true"></div>

      {/* Coluna 3 — só o shortcode do chat, sem card em volta (como nas LPs de parafuso e peças).
          A altura de 340px só é reservada no desktop; no celular o chat ocupa o que renderizar. */}
      <div class="hero-chat w-full lg:w-[340px]">
        <div class="w-full lg:min-h-[340px]">
          <slot name="shortcode">
            {isDev ? (
              <div
                class="flex min-h-[340px] w-full flex-col gap-3 text-left"
                aria-label="Mock do chat (só em desenvolvimento)"
              >
                <span class="font-sans text-[11px] font-semibold tracking-[0.18em] text-brand-yellow uppercase">
                  Mock · chat
                </span>
                <div class="h-11 rounded-lg bg-neutral-light/10" />
                <div class="h-11 rounded-lg bg-neutral-light/10" />
                <div class="h-11 rounded-lg bg-neutral-light/10" />
                <div class="h-11 rounded-lg bg-neutral-light/10" />
                <div class="mt-auto h-12 rounded-full bg-brand-yellow" />
              </div>
            ) : (
              <div class="flex min-h-[340px] w-full flex-col items-center justify-center gap-3 rounded-xl border border-dashed border-neutral-light/30 p-6 text-center">
                <span class="font-sans text-[11px] font-semibold tracking-[0.18em] text-accent-orange uppercase">
                  Espaço reservado
                </span>
                <p class="font-display text-lg font-bold text-neutral-light">Shortcode — 340px</p>
              </div>
            )}
          </slot>
        </div>
      </div>
    </div>
  </div>

  {/* Overlay de depuração: ?grid=1 */}
  <div data-hero-grid hidden class="pointer-events-none absolute inset-0 z-[9]">
    <div class="hero-photo absolute inset-0 hidden lg:block">
      <div class="absolute inset-y-0 left-0 border-l-2 border-dashed border-brand-yellow">
        <span class="m-2 inline-block bg-black/60 px-2 font-mono text-[11px] whitespace-nowrap text-brand-yellow">
          início da foto
        </span>
      </div>
    </div>
    <div class="page-container h-full">
      <div class="hero-grid grid h-full lg:gap-x-6">
        <div class="border-x border-dashed border-white/60">
          <span class="m-2 inline-block bg-black/60 px-2 font-mono text-[11px] text-white">
            col 1 · texto
          </span>
        </div>
        <div class="hidden border-x border-dashed border-brand-yellow lg:block">
          <span class="m-2 inline-block bg-black/60 px-2 font-mono text-[11px] text-brand-yellow">
            col 2 · 270px · vazia
          </span>
        </div>
        <div class="hidden border-x border-dashed border-white/60 lg:block">
          <span class="m-2 inline-block bg-black/60 px-2 font-mono text-[11px] text-white">
            col 3 · 340px · shortcode
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Fundo do mockup: navy quase uniforme atrás do texto (#012751 medido no mockup). */
  .hero {
    background: linear-gradient(180deg, #01264e 0%, #012751 55%, #012856 100%);
  }

  /* Barra de vidro dos 4 pontos, a mesma das LPs de parafuso e peças: translúcida, com
     desfoque do que passa por trás e um filete de luz no alto. */
  .hero-glass {
    background-color: rgb(1 32 70 / 0.55);
    background-image: linear-gradient(
      160deg,
      rgb(255 255 255 / 0.12) 0%,
      rgb(255 255 255 / 0.04) 100%
    );
    border: 1px solid rgb(255 255 255 / 0.14);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.18),
      0 18px 40px -24px rgb(0 0 0 / 0.7);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    backdrop-filter: blur(14px) saturate(140%);
  }

  /* Metade da largura da página (1450px / 2): ancora as colunas e a foto no mesmo eixo. */
  .hero-photo,
  .hero-grid {
    --page-half: calc(var(--container-page) / 2);
    --page-edge: max(0px, calc(50% - var(--page-half)));
    /* Fim da coluna de texto: page-edge + min(100%, página) − 706px (padding 48 · 270 · 340 · 2 gaps de 24). */
    --col-end: calc(var(--page-edge) + min(100%, var(--container-page)) - 706px);
  }

  /* Mobile: a faixa da foto no rodapé do hero nasce do fundo navy, sem borda reta. */
  .hero-fade {
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 7rem);
    mask-image: linear-gradient(to bottom, transparent 0, #000 7rem);
  }

  @media (min-width: 1024px) {
    /* Col 1 (1fr) | Col 2 janela do banner | Col 3 shortcode 340px */
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) 270px 340px;
    }

    /* A foto começa 100px antes do fim da coluna 1 — o texto (máx. 32rem) acaba antes disso — */
    /* e vai até a borda da tela. Com o hero de ao menos 752px, o compressor aberto e o técnico */
    /* (primeiros ~30% do banner) caem logo depois do texto, e o técnico fica livre do card do */
    /* chat a partir de ~1440px. */
    .hero-photo {
      left: calc(var(--col-end) - 100px);
      right: 0;
    }

    /* Abaixo de 1440px a coluna 1 encolhe, mas a manchete e a barra de pontos não: */
    /* a foto começa depois delas (~640px da borda do conteúdo), fora do texto (26/10/2026). */
    @media (max-width: 1439px) {
      .hero-photo {
        left: max(calc(var(--col-end) - 100px), calc(var(--page-edge) + 640px));
      }
    }

    /* Desktop: a imagem tem a largura natural (altura do hero × proporção do banner) e a */
    /* máscara é medida nela, não na caixa: a foto ocupa os primeiros ~35% do banner e o resto */
    /* é a extensão azul, mais clara que o navy da seção. A borda esquerda some em 10% e a */
    /* direita se dissolve devagar, de 19% a 38%, com paradas em curva (ease-out) — sem linha */
    /* visível e sem a extensão azul aparecer (pedido do usuário, 27/10/2026). Máscara, e não */
    /* véu por cima, para não haver cor a casar. */
    .hero-fade {
      -webkit-mask-image: none;
      mask-image: none;
    }

    .hero-fade :global(img) {
      --hero-mask: linear-gradient(
        to right,
        transparent 0%,
        rgb(0 0 0 / 0.3) 3%,
        rgb(0 0 0 / 0.7) 6%,
        #000 10%,
        #000 19%,
        rgb(0 0 0 / 0.85) 23%,
        rgb(0 0 0 / 0.62) 27%,
        rgb(0 0 0 / 0.38) 30.5%,
        rgb(0 0 0 / 0.18) 33.5%,
        rgb(0 0 0 / 0.06) 36%,
        transparent 38%
      );
      -webkit-mask-image: var(--hero-mask);
      mask-image: var(--hero-mask);
    }
  }
</style>

<script>
  // Overlay de depuração do grid: abra a página com ?grid=1
  if (new URLSearchParams(location.search).get('grid') === '1') {
    document.querySelectorAll<HTMLElement>('[data-hero-grid]').forEach((el) => {
      el.hidden = false
    })
  }
</script>
